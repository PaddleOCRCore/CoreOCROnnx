<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <!-- Package Identity -->
	  <PackageId>CoreOCROnnx.SDK</PackageId>
	  <Version>4.1.0-beta01</Version>
	  <Authors>PaddleOCRCore</Authors>
	  <Company>PaddleOCRCore</Company>

	  <!-- Package Description -->
	  <Title>CoreOCROnnx SDK for .NET</Title>
	  <Description>Offline OCR and YOLO SDK for .NET, supporting PaddleOCR text detection, direction classification and text recognition through ONNX Runtime, OpenVINO or TensorRT native runtime packages.</Description>
	  <PackageTags>OCR;PaddleOCR;ONNX;OpenVINO;TensorRT;YOLO;.NET;文字识别;离线OCR</PackageTags>
	  <PackageReadmeFile>readme.md</PackageReadmeFile>

	  <!-- License and Copyright -->
	  <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	  <Copyright>Copyright (c) PaddleOCRCore</Copyright>

	  <!-- Repository Information -->
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/PaddleOCRCore/CoreOCROnnx</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/PaddleOCRCore/CoreOCROnnx</PackageProjectUrl>

	  <!-- Icon and Release Notes -->
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageReleaseNotes>See https://github.com/PaddleOCRCore/CoreOCROnnx/releases for release notes.</PackageReleaseNotes>

	  <!-- Build Settings -->
	  <TargetFrameworks>netstandard2.0;net45;net461;net47;net48;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
	  <PlatformTarget>x64</PlatformTarget>
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

	  <!-- NuGet Health Settings -->
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <Deterministic>true</Deterministic>
	  <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
	<ItemGroup>
	  <None Include="readme.md" Pack="true" PackagePath="\" />
	  <None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup Condition="Exists('PaddleOCR')">
		<None Include="PaddleOCR\**\*">
			<Pack>true</Pack>
			<PackageCopyToOutput>true</PackageCopyToOutput>
			<PackagePath>build\PaddleOCR</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="OCRModels\**" />
	  <EmbeddedResource Remove="OCRModels\**" />
	  <None Remove="OCRModels\**" />
	</ItemGroup>
</Project>
